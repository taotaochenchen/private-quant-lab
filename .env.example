# Copy to .env and fill locally. Never commit .env.

# Model name determines endpoint and API key env.
# DeepSeek example: deepseek-v4-flash
# ChatGPT/OpenAI example: gpt-5.6-sol
MODEL_NAME=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional overrides.
DEEPSEEK_BASE_URL=
OPENAI_BASE_URL=
MODEL_TIMEOUT_SECONDS=60
